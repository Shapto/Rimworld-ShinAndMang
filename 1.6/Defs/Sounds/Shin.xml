<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <SoundDef>
    <defName>Shin_Add</defName>
    <context>MapOnly</context>
    <maxSimultaneous>2</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Shin/shin_add</clipPath>
          </li>
        </grains>
        <volumeRange>30~35</volumeRange>
        <paramMappings>
          <li>
            <inParam Class="SoundParamSource_CameraAltitude" />
            <outParam Class="SoundParamTarget_Volume" />
            <curve>
              <points>
                <li>(15, 1)</li>
                <li>(40, 0.4)</li>
                <li>(65, 0)</li>
              </points>
            </curve>
          </li>
        </paramMappings>
      </li>
    </subSounds>
  </SoundDef>

  <SoundDef>
    <defName>Shin_Loop</defName>
    <context>MapOnly</context>
    <sustain>true</sustain>
    <priorityMode>PrioritizeNearest</priorityMode>
    <maxSimultaneous>3</maxSimultaneous>
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>Shin/shin_loop</clipPath>
          </li>
        </grains>
        <volumeRange>15~18</volumeRange>
        <paramMappings>
          <li>
            <inParam Class="SoundParamSource_CameraAltitude" />
            <outParam Class="SoundParamTarget_Volume" />
            <curve>
              <points>
                <li>(15, 1)</li>
                <li>(40, 0.4)</li>
                <li>(65, 0)</li>
              </points>
            </curve>
          </li>
        </paramMappings>
        <sustainLoop>true</sustainLoop>
        <sustainAttack>0.2</sustainAttack>
        <sustainRelease>0.15</sustainRelease>
      </li>
    </subSounds>
  </SoundDef>

</Defs>