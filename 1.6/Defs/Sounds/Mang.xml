<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<SoundDef>
		<defName>Mang_RingForm</defName>
		<context>MapOnly</context>
		<maxSimultaneous>4</maxSimultaneous>
		<subSounds>
			<li>
				<grains>
					<li Class="AudioGrain_Clip">
						<clipPath>Mang/RingForm</clipPath>
					</li>
				</grains>
				<volumeRange>50~60</volumeRange>
				<pitchRange>0.97~1.03</pitchRange>
				<paramMappings>
					<li>
						<inParam Class="SoundParamSource_CameraAltitude" />
						<outParam Class="SoundParamTarget_Volume" />
						<curve>
						<points>
							<li>(15, 1)</li>
							<li>(40, 0.4)</li>
							<li>(65, 0)</li>
						</points>
						</curve>
					</li>
				</paramMappings>
			</li>
		</subSounds>
	</SoundDef>

	<SoundDef>
		<defName>Mang_RingFormComplete</defName>
		<context>MapOnly</context>
		<maxSimultaneous>1</maxSimultaneous>
		<subSounds>
			<li>
				<grains>
					<li Class="AudioGrain_Clip">
						<clipPath>Mang/RingFormComplete</clipPath>
					</li>
				</grains>
				<volumeRange>60~60</volumeRange>
				<paramMappings>
					<li>
						<inParam Class="SoundParamSource_CameraAltitude" />
						<outParam Class="SoundParamTarget_Volume" />
						<curve>
						<points>
							<li>(15, 1)</li>
							<li>(40, 0.4)</li>
							<li>(65, 0)</li>
						</points>
						</curve>
					</li>
				</paramMappings>
			</li>
		</subSounds>
	</SoundDef>

</Defs>